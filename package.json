{
  "name": "feistly",
  "version": "0.1.0",
  "description": "Feistel-based format-preserving obfuscation for auto-increment keys",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:example": "tsx examples/basic.ts",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsx": "^4.16.2",
    "typescript": "^5.6.3"
  }
}
